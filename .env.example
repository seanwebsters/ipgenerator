# ── Required ─────────────────────────────────────────────
DATABASE_URL=postgresql://webster:webster@localhost:5432/webster
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored provider keys.
# Optional in development (a key is generated into storage/.dev-secret-key); required in production.
WEBSTER_SECRET_KEY=

# Founder account created by `npm run db:seed`
WEBSTER_FOUNDER_EMAIL=founder@webster.studio
WEBSTER_FOUNDER_PASSWORD=change-me
WEBSTER_FOUNDER_NAME=Founder

# Media storage (local driver). Defaults to ./storage/media
# STORAGE_DIR=

# ── Providers (all optional; keys can also be stored encrypted from Settings) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# A voice from your licensed ElevenLabs library. Never a cloned real person without documented authorisation.
ELEVENLABS_VOICE_ID=
# Budgeting estimates for providers that don't return prices
# OPENAI_IMAGE_USD=0.07
# ELEVENLABS_USD_PER_1K_CHARS=0.10

# ── YouTube (publishing + analytics; OAuth with youtube.upload + yt-analytics.readonly) ──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Engine tuning ────────────────────────────────────────
# Minutes after release before the first learning review (production: days).
LEARNING_REVIEW_DELAY_MIN=10
# Unique viewers required before the learning agent proposes an experiment.
LEARNING_MIN_VIEWERS=20
# FFMPEG_PATH=/usr/bin/ffmpeg

# ── Hosting (all default automatically on Vercel; see "Deploy to Vercel" in README) ──
# "inline": run engine jobs inside the web app instead of `npm run worker`.
# WEBSTER_ENGINE=inline
# "db": keep media in Postgres instead of STORAGE_DIR.
# STORAGE_DRIVER=db
# "1": render text with the fonts in assets/fonts instead of system fonts.
# WEBSTER_BUNDLED_FONTS=1
# Lets Vercel Cron (or any scheduler) call GET /api/engine/tick.
# CRON_SECRET=
